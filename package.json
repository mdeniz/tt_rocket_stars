{
  "name": "tt-rocket-stars",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Offline-first space-themed multiplication and division game",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/check-dist.cjs",
    "api:dev": "wrangler dev --local",
    "api:typecheck": "tsc --noEmit -p tsconfig.api.json",
    "api:test": "node --experimental-strip-types --test tests/unit/api-*.test.cjs",
    "db:local:up": "docker compose -f docker-compose.local.yml up -d postgres",
    "db:local:down": "docker compose -f docker-compose.local.yml down",
    "db:local:reset": "docker compose -f docker-compose.local.yml down -v && docker compose -f docker-compose.local.yml up -d postgres",
    "db:migrate": "drizzle-kit migrate",
    "test:integration": "node scripts/run-local-database-tests.cjs",
    "db:backup:restore:test": "node scripts/run-local-database-backup-restore.cjs",
    "migration:synthetic": "node scripts/synthetic-migration.mjs",
    "release": "node scripts/release.mjs",
    "check:cutover": "node scripts/check-cutover.cjs",
    "check:retirement": "node scripts/check-legacy-retirement.cjs",
    "check:migrations": "node scripts/check-migrations.cjs",
    "db:migrations:reset": "node scripts/check-migrations.cjs --apply-clean",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:full": "PLAYWRIGHT_FULL=1 playwright test",
    "check:legacy": "node scripts/check-legacy.cjs",
    "check": "npm run check:legacy && npm run check:cutover && npm run check:retirement && npm run check:migrations && npm run typecheck && npm run api:typecheck && npm run test:unit && npm run api:test && npm run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@playwright/test": "^1.55.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^7.1.0",
    "wrangler": "^4.155.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@better-auth/drizzle-adapter": "1.7.14",
    "better-auth": "1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
