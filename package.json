{
  "name": "tt-rocket-stars",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Offline-first space-themed multiplication and division game",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/check-dist.cjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:full": "PLAYWRIGHT_FULL=1 playwright test",
    "check:legacy": "node scripts/check-legacy.cjs",
    "check": "npm run check:legacy && npm run typecheck && npm run test:unit && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
