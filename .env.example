# Public Supabase configuration consumed by the browser client.
# Never place a Supabase service-role or secret key in this file.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<public-anon-key>

# Authentication return origin. Use the local value for Vite and the HTTPS
# GitHub Pages value for production.
VITE_APP_SITE_URL=http://localhost:5173/
